# Copy to .streamlit/secrets.toml (never commit it). On Streamlit Community Cloud paste this into App → Settings → Secrets.

# Pick ONE database. Leave DATABASE_URL out to use a local SQLite file (demo only: resets on Streamlit Cloud reboots).
# Hostinger MySQL:
# DATABASE_URL = "mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME"
# Supabase Postgres (Project → Connect → Session pooler URI):
# DATABASE_URL = "postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# 1 = demo: auto-loads fictional data and shows demo logins on the sign-in page. Set 0 for real use.
DEMO_MODE = "1"
